# ─────────────────────────────────────────────────────────────
#  .env.example — Template for environment variables.
#
#  HOW TO USE:
#    1. Copy this file:   cp .env.example .env
#    2. Fill in your real values in .env
#    3. NEVER commit .env — it is listed in .gitignore
#
#  WHERE TO GET CREDENTIALS:
#    Groq (free tier): https://console.groq.com
# ─────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────
# Your API key from the provider dashboard (e.g. Groq, OpenAI)
LLM_API_KEY=your_api_key_here

# Base URL of the OpenAI-compatible API endpoint.
# Groq:   https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model identifier supported by the chosen provider.
# Default: openai/gpt-oss-20b (Groq-hosted, supports structured outputs)
# Alternatives:
#   llama-3.3-70b-versatile (more accurate, slower)
#   openai/gpt-oss-20b      (default — structured output support)
LLM_MODEL=openai/gpt-oss-20b

# ── LLM Parameters ────────────────────────────────────────────
# Maximum number of tokens the model may generate per response.
# 4096 gives the model sufficient room to emit the full JSON schema response.
LLM_MAX_TOKENS=4096

# Controls output randomness. 0.0 = deterministic, 1.0 = creative.
# Keep low (0.1) for consistent structured JSON output.
LLM_TEMPERATURE=0.1

# Request timeout in seconds before giving up on a single API call.
LLM_TIMEOUT_SECONDS=30

# ── Retry & Rate-Limit Settings ───────────────────────────────
# Maximum number of retry attempts on transient API errors (429, 5xx).
LLM_MAX_RETRIES=3

# ── Batch Processing ──────────────────────────────────────────
# How many feedback rows to send to the LLM in one processing pass.
# Smaller values reduce rate-limit risk; larger values are faster.
BATCH_SIZE=5

# Seconds to pause between batches (helps avoid rate-limit errors).
BATCH_DELAY_SECONDS=1

# ── Application Settings ──────────────────────────────────────
# Maximum CSV file size accepted by the uploader (in megabytes).
MAX_CSV_SIZE_MB=5

# Maximum number of rows allowed in a single CSV upload.
MAX_CSV_ROWS=1000
